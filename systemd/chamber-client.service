[Unit]
Description=Buckyball chamber playback/recording client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chamber
# Replace <chamber-uid> with the actual UID (run `id -u chamber` to get it).
# Don't use the %U specifier here -- on some systemd versions it doesn't
# resolve to this unit's User= and silently falls back to UID 0 (root)
# instead, pointing XDG_RUNTIME_DIR at a runtime dir with no PulseAudio
# session in it.
Environment=XDG_RUNTIME_DIR=/run/user/<chamber-uid>
WorkingDirectory=/opt/buckyball-chamber
ExecStart=/opt/buckyball-chamber/.venv/bin/python -m client.main --config /opt/buckyball-chamber/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
